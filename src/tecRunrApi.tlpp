#include "tlpp-core.th"

// NOTA sobre namespace: este arquivo tem `namespace tec.runner.api` porque
// as funcoes (tecRunrPing/Func/Exec) sao acessadas via REST annotations
// (@Get/@Post), que registram a rota independente do alias `u_`. O helper
// u_tecRunrToStr ainda fica acessivel via `tec.runner.api.u_tecRunrToStr`
// se precisar chamar externo. Pra modulos cujas funcoes precisam ser
// chamadas externamente via /runner/exec (tecAssert, tecWrap, tecMock,
// tecRunrCtx, tecRefl), NAO use namespace - registro ficaria como
// `<ns>.u_<nome>` em vez do `u_<nome>` global que o /runner/exec espera.
namespace tec.runner.api

// Os handlers REST retornam .T. mesmo nas respostas de erro: com .F. o tlppCore
// descarta o corpo montado e devolve um 500 generico ("Internal Server Error").
// O erro chega ao cliente pelo setStatusCode + corpo JSON.

//------------------------------------------------------------------------------
/*/{Protheus.doc} tecRunrPing
Health check do tlpp-runner.
GET /rest/runner/ping
@type user function
@author Guilherme Pegoraro
@since 09/05/2026
@return logical, sempre .T. (o resultado vai no corpo: status, env, company, branch, timestamp)
/*/
//------------------------------------------------------------------------------
@Get("/runner/ping")
user function tecRunrPing()
    local jResp := JsonObject():new()

    jResp["status"]    := "ok"
    jResp["env"]       := GetEnvServer()
    jResp["company"]   := cEmpAnt
    jResp["branch"]    := cFilAnt
    jResp["timestamp"] := DToS(Date()) + " " + Time()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:setStatusCode(200)
    oRest:setResponse(jResp:toJson())
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} tecRunrFunc
Verifica se uma funcao existe no RPO.
GET /rest/runner/func?name=u_tecCalcDsc
@type user function
@author Guilherme Pegoraro
@since 09/05/2026
@return logical, sempre .T. (200 {function, exists} ou 400 name_obrigatorio)
/*/
//------------------------------------------------------------------------------
@Get("/runner/func")
user function tecRunrFunc()
    local jResp := JsonObject():new()
    local cName := ""
    local jPath

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    jPath := oRest:getQueryRequest()
    if jPath != nil .and. jPath:hasProperty("name")
        cName := AllTrim(jPath["name"])
    endif

    if Empty(cName)
        oRest:setStatusCode(400)
        oRest:setResponse('{"error":"name_obrigatorio"}')
        return .T.
    endif

    jResp["function"] := cName
    jResp["exists"]   := tlpp.ffunc(cName)

    oRest:setStatusCode(200)
    oRest:setResponse(jResp:toJson())
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} tecRunrExec
Executa funcao TLPP/AdvPL pelo nome.
POST /rest/runner/exec  body: {"function":"...", "argString":"\"a\",\"b\""}

Resposta 200: {function, argString, result, duration, env, asserts?}
Resposta 500: {error:"runtime", function, argString, message, stack, duration, asserts?}
`asserts` (= u_tecAssertSummary(): ok, passed, failed, fails[]) so vem quando a
chamada registrou ao menos um assert.

Executa a expressao montada com o corpo do request (funcao + argString): e
execucao remota de codigo por desenho. Exige Basic auth (SECURITY=1) e existe
so para AppServer local de desenvolvimento - nunca habilitar em ambiente de
cliente.
@type user function
@author Guilherme Pegoraro
@since 09/05/2026
@return logical, sempre .T. (o status HTTP e o corpo carregam o resultado)
/*/
//------------------------------------------------------------------------------
@Post("/runner/exec")
user function tecRunrExec()
    local jReq, jResp
    local cBody     := ""
    local cFunc     := ""
    local cArgs     := ""
    local cCallStr  := ""
    local cErr      := ""
    local cStack    := ""
    local nStart    := 0
    local nDuration := 0
    local xResult   := nil
    local lErro     := .F.
    local oErr      := nil

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Limpa contexto de qualquer request anterior (thread pode ser reutilizada)
    u_tecCtxClear()

    // Higiene de modo teste: se um teste anterior NESTA thread estourou antes
    // do u_tecTstStop(), lModoTst/mocks (statics por thread) vazariam pro
    // request seguinte - funcao de producao rodaria recebendo mock.
    u_tecTstStop()

    cBody := oRest:getBodyRequest()
    if Empty(cBody)
        oRest:setStatusCode(400)
        oRest:setResponse('{"error":"body_vazio"}')
        return .T.
    endif

    jReq := JsonObject():new()
    cErr := jReq:fromJson(cBody)
    if !Empty(cErr)
        oRest:setStatusCode(400)
        oRest:setResponse('{"error":"json_invalido"}')
        return .T.
    endif

    if jReq:hasProperty("function")
        cFunc := AllTrim(jReq["function"])
    endif
    if Empty(cFunc)
        oRest:setStatusCode(400)
        oRest:setResponse('{"error":"function_obrigatoria"}')
        return .T.
    endif

    if jReq:hasProperty("argString")
        cArgs := jReq["argString"]
    endif

    // Contexto per-project: PS1 manda projectName/testDbAlias/dbAccessHost/Port
    // Helpers (u_tecTstConn etc) leem via u_tecCtxGet
    if jReq:hasProperty("projectName")
        u_tecCtxSet("projectName", jReq["projectName"])
    endif
    if jReq:hasProperty("testDbAlias")
        u_tecCtxSet("testDbAlias", jReq["testDbAlias"])
    endif
    if jReq:hasProperty("dbAccessHost")
        u_tecCtxSet("dbAccessHost", jReq["dbAccessHost"])
    endif
    if jReq:hasProperty("dbAccessPort")
        u_tecCtxSet("dbAccessPort", jReq["dbAccessPort"])
    endif

    if !tlpp.ffunc(cFunc)
        jResp := JsonObject():new()
        jResp["error"]    := "funcao_nao_existe"
        jResp["function"] := cFunc
        oRest:setStatusCode(404)
        oRest:setResponse(jResp:toJson())
        return .T.
    endif

    cCallStr := cFunc + "(" + cArgs + ")"

    // Contadores de assert sao static por thread: zerados aqui, o resumo da
    // resposta reflete so esta chamada.
    u_tecAssertReset()
    nStart := Seconds()

    // Erro de execucao na funcao chamada (tipo invalido, variavel inexistente...)
    // cai no catch com descricao e pilha. Precisa ser try/catch: com ErrorBlock +
    // BEGIN SEQUENCE o bloco de erro roda, mas o Break disparado dentro da chamada
    // por macro/tlpp.call nao chega ao RECOVER daqui - a chamada voltaria como
    // sucesso com retorno vazio.
    // Funcao sem namespace vai por macro, que preserva na pilha a linha do fonte
    // chamado; o tlpp.call relanca o erro e a pilha comeca nele. Nome longo
    // (namespace, ex. tlpp.probat.run) a macro nao resolve: so pelo tlpp.call.
    // Break(<texto>) explicito escapa do catch e sai como 500 generico do tlppCore.
    try
        if "." $ cFunc
            xResult := tlpp.call(cCallStr)
        else
            xResult := &(cCallStr)
        endif
    catch oErr
        lErro  := .T.
        cErr   := oErr:Description
        cStack := oErr:ErrorStack
    endtry
    // Seconds() zera a meia-noite: chamada que atravessa a virada soma o dia
    nDuration := Seconds() - nStart
    if nDuration < 0
        nDuration += 86400
    endif

    jResp := JsonObject():new()
    jResp["function"]  := cFunc
    jResp["argString"] := cArgs

    if lErro
        // Erro na funcao chamada pode ter deixado modo teste ligado
        u_tecTstStop()
        jResp["error"]    := "runtime"
        jResp["message"]  := cErr
        jResp["stack"]    := cStack
        jResp["duration"] := nDuration
        tecRunrAsserts(jResp, cFunc)
        oRest:setStatusCode(500)
        oRest:setResponse(jResp:toJson())
        return .T.
    endif

    jResp["result"]    := u_tecRunrToStr(xResult)
    jResp["duration"]  := nDuration
    jResp["env"]       := GetEnvServer()
    tecRunrAsserts(jResp, cFunc)

    oRest:setStatusCode(200)
    oRest:setResponse(jResp:toJson())
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} tecRunrAsserts
Anexa o resumo dos asserts a resposta quando a chamada registrou algum assert.
As falhas (`fails`) chegam ao cliente na propria resposta, sem ler console.log.
Nome com namespace (ex. tlpp.probat.run) roda varios testes, cada um zerando
os contadores: o resumo seria so o do ultimo, entao nao vai.
@type static function
@author Guilherme Pegoraro
@since 02/10/2026
@param jResp, json, resposta em montagem (recebe a chave `asserts`)
@param cFunc, character, nome da funcao executada
@return nil
/*/
//------------------------------------------------------------------------------
static function tecRunrAsserts(jResp, cFunc)
    local jSum := nil
    if "." $ cFunc
        return nil
    endif
    jSum := u_tecAssertSummary()
    if jSum["passed"] + jSum["failed"] > 0
        jResp["asserts"] := jSum
    endif
return nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} tecRunrToStr
Converte qualquer tipo de retorno para o texto do campo `result`.
@type user function
@author Guilherme Pegoraro
@since 11/05/2026
@param xVal, variant, valor retornado pela funcao executada
@return character, ".T."/".F.", numero, DToS, JSON (JsonObject) ou <tipo>
/*/
//------------------------------------------------------------------------------
user function tecRunrToStr(xVal)
    local cType := ValType(xVal)
    do case
        case cType == "U" ; return ""
        case cType == "C" ; return xVal
        case cType == "N" ; return cValToChar(xVal)
        case cType == "L" ; return iif(xVal, ".T.", ".F.")
        case cType == "D" ; return DToS(xVal)
        case cType == "A" ; return "<array len=" + cValToChar(Len(xVal)) + ">"
        case cType == "O" ; return "<object>"
        case cType == "J" ; return xVal:toJson()
    endcase
return "<" + cType + ">"
